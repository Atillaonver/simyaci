{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="page-ctrl-controls" data-iwidth="" data-owidth="">
        <button type="button" id="button-repair" data-bs-toggle="tooltip" title="{{ button_rebuild }}" class="btn btn-light"><i class="fa-solid fa-rotate"></i></button>
        <a href="{{ add }}" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa-solid fa-plus"></i></a>
        <button type="submit" form="form-category" formaction="{{ delete }}" data-bs-toggle="tooltip" title="{{ button_delete }}" onclick="return confirm('{{ text_confirm }}');" class="btn btn-danger"><i class="fa-regular fa-trash-can"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-list"></i> {{ text_list }} </div>
      <div id="category" class="card-body">{{ list }}</div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$(document).ready(function()
{
	{% if lst %}
			element = document.getElementById('ca{{ lst }}');
			element.classList.add("lastone");
			$("html, body").animate({scrollTop:element.offsetTop}, 500);
	{% endif %}
});

$(document).on('click', '#form-category [data-bs-toggle=\'modal\']', function (e) {
    e.preventDefault();
    var element = this;
    var targetUrl = $(element).attr('data-link');

    // 1. TAM TEMİZLİK (Hata buradaki kalıntılardan çıkıyor)
    $('.modal-backdrop').remove(); // Eski karartmaları sil
    $('#modal-category-product-order').remove(); // Eski modalı sil
    $('body').removeClass('modal-open').css('overflow', ''); // Sayfa kilidini aç

    $.ajax({
        url: targetUrl,
        dataType: 'html',
        success: function (html) {
            // 2. HTML'i ekle
            $('body').append(html);

            var modalEl = document.getElementById('modal-category-product-order');
            
            // 3. ÖNCE ÖRNEĞİ OLUŞTUR, SONRA GÖSTER
            // getOrCreateInstance kullanarak çakışmayı önlüyoruz
            var modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl, {
                backdrop: 'static',
                keyboard: true
            });

            modalInstance.show();

            // 4. SORTABLE'I TETİKLE
            modalEl.addEventListener('shown.bs.modal', function () {
                if (typeof readyAll === 'function') {
                    readyAll();
                }
            });
        }
    });
});

$(document).on('click','#form-category [data-bs-toggle=\'modalX\']', function (e) {
        e.preventDefault();
        var element = this;
         $('#modal-category-product-order').remove();
        $.ajax({
            url: $(element).attr('data-link'),
            dataType: 'html',
            success: function (html) {
                $('body').append(html);
                var element = document.querySelector('#modal-category-product-order');
                var modal = new bootstrap.Modal(element);
                modal.show();
            }
        });
    });

$(document).on('click', '.btn-order-triggerX', function (e) {
    e.preventDefault();
    var element = this;
    
    // 1. Önceki modal kalıntılarını temizle (Backdrop hatasını engeller)
    $('#modal-category-product-order').remove();
    $('.modal-backdrop').remove(); 
    $('body').removeClass('modal-open').css('overflow', '');

    $.ajax({
        url: $(element).attr('data-link'),
        dataType: 'html',
        success: function (html) {
            // 2. Yeni HTML'i ekle
            $('body').append(html);
            
            var modalElement = document.getElementById('modal-category-product-order');
            
            // 3. Modalı Manuel Başlat
            var myModal = new bootstrap.Modal(modalElement, {
                backdrop: 'static', // Yanlışlıkla dışarı tıklayıp sıralamayı kaybetmemek için
                keyboard: true
            });
            
            myModal.show();

            // 4. Modal açıldıktan sonra Sortable'ı tetikle
            modalElement.addEventListener('shown.bs.modal', function () {
                // Eğer sortable hala çalışmıyorsa burada tekrar initialize edebilirsin
                if (typeof readyAll === "function") readyAll();
            });
        }
    });
});

$(document).on('show.bs.modal','#modal-list-order', function (event) {
  var button = $(event.relatedTarget)
  var recipient = button.data('link')
  var modal = $(this)
   $.ajax({
		url: recipient ,
		dataType: 'json',	
		success: function(json) {
			if(json['body']){
				$('#modal-body').html(json['body']);	
			}
			if(json['title']){
				modal.find('.modal-title').text(json['title']);	
			}
		}
	});
});

//--></script>

<script type="text/javascript"><!--
$('#category').on('click', 'thead a, .pagination a', function (e) {
    e.preventDefault();

    $('#category').load(this.href);
});

$('#button-repair').on('click', function (e) {
    e.preventDefault();
    
    var element = this;

    $.ajax({
        url: 'index.php?route=catalog/category.repair&user_token={{ user_token }}',
        dataType: 'json',
        beforeSend: function () {
            $(element).button('loading');
        },
        complete: function () {
            $(element).button('reset');
        },
        success: function (json) {
            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['success']) {
                $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');

                $('#category').load('index.php?route=catalog/category.list&user_token={{ user_token }}');
            }
        },
        error: function (xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>

{{ footer }}
